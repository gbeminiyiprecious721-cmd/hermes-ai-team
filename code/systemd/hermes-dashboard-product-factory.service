[Unit]
Description=Hermes Product Factory Mission Control Dashboard (Tailscale-only, isolated)
After=network-online.target tailscaled.service hermes-dashboard.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash -c '/usr/local/lib/hermes-agent/venv/bin/python -m hermes_cli.main --profile product-factory dashboard --isolated --host 127.0.0.1 --port 9220 --skip-build --no-open'
WorkingDirectory=/root/.hermes/profiles/product-factory
Environment="PATH=/usr/local/lib/hermes-agent/venv/bin:/usr/local/lib/hermes-agent/node_modules/.bin:/root/.hermes/node/bin:/root/.hermes/node:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/usr/local/lib/hermes-agent/venv"
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
