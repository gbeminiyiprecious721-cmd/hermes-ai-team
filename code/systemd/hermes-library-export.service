[Unit]
Description=Hermes library exporter (finished Kanban tasks to Obsidian inbox drafts)
After=hermes-gateway.service

[Service]
Type=simple
ExecStart=/usr/local/lib/hermes-agent/venv/bin/python /root/.hermes/scripts/library_export.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
